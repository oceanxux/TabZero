{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "4.3.1",
  "description": "__MSG_appDesc__",
  "permissions": [
    "favicon",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "zh_CN"
}
