{
  "manifest_version": 3,
  "name": "TabZero",
  "version": "4.1",
  "description": "TabZero - 极简高颜值新标签页，支持 WebDAV 端到端 AES-256-GCM 强加密同步、浏览器原生书签导入导出、多搜索引擎快捷切换与每日高清壁纸",
  "permissions": [
    "favicon",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
